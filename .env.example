# Server
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins.
# In production, only these origins may make CORS requests (same-origin SPA needs none).
CLIENT_ORIGIN=http://localhost:5173

# Auth
# REQUIRED in production: at least 32 random characters. The app refuses to start
# in production if this is missing, too short, or still the development default.
# Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# In production, secure (HTTPS-only) cookies are required. The app refuses to start
# in production unless COOKIE_SECURE=1. Set COOKIE_SECURE=0 only for local HTTP testing.
COOKIE_SECURE=0

# Database (optional). Defaults to <project root>/data.db
# DB_PATH=

# Uploads (optional). Defaults to <project root>/uploads
# UPLOADS_DIR=

# Database backups (optional). Defaults to <project root>/backups
# BACKUP_DIR=

# Rate limiting (optional overrides; sensible production defaults apply)
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_REGISTER_MAX=10
# RATE_LIMIT_INITIATE_MAX=8
# RATE_LIMIT_UPLOAD_MAX=60
# RATE_LIMIT_CALLBACK_MAX=600

# M-Pesa (Daraja STK Push).
# Leave blank for mock/demo mode in development only. In production, mock mode is
# disabled and MPESA_ENV must be "production" with a public HTTPS callback URL.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
