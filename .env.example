# Server
NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins.
# In production, only these origins may make CORS requests (same-origin SPA needs none).
CLIENT_ORIGIN=http://localhost:5173

# Auth
# REQUIRED in production: at least 32 random characters. The app refuses to start
# in production if this is missing, too short, or still the development default.
# Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# In production, secure (HTTPS-only) cookies are required. The app refuses to start
# in production unless COOKIE_SECURE=1. Set COOKIE_SECURE=0 only for local HTTP testing.
COOKIE_SECURE=0

# Database (optional). Defaults to <project root>/data.db
# DB_PATH=

# Seed admin password. Used only by `npm run seed` / `npm run import:riesta` when creating the
# first admin. In production a value is REQUIRED to avoid a predictable admin password; if left
# blank in production the seed generates a random password and prints it once. Ignored when the
# admin account already exists.
# SEED_ADMIN_PASSWORD=

# Uploads (optional). Defaults to <project root>/uploads
# UPLOADS_DIR=

# Database backups (optional). Defaults to <project root>/backups
# BACKUP_DIR=

# Rate limiting (optional overrides; sensible production defaults apply)
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_REGISTER_MAX=10
# RATE_LIMIT_INITIATE_MAX=8
# RATE_LIMIT_UPLOAD_MAX=60
# RATE_LIMIT_CALLBACK_MAX=600

# M-Pesa (Daraja STK Push).
# Leave blank for mock/demo mode in development only. In production, mock mode is
# disabled and MPESA_ENV must be "production" with a public HTTPS callback URL.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# Public base URL used to build tenant activation links (must be HTTPS in production).
# Defaults to the first CLIENT_ORIGIN value.
# PUBLIC_BASE_URL=https://your-domain.example

# Tenant account activation link lifetime, in hours.
# ACTIVATION_TTL_HOURS=48

# SMS notifications.
# Provider options:
#   mock      - logs messages only, nothing is sent (default; never sends real SMS)
#   http      - generic REST gateway (requires SMS_API_URL + SMS_API_KEY)
#   disabled  - turns SMS off entirely
# SMS_PROVIDER=mock
# SMS_SENDER_ID=SMARTRENT
# Set SMS_ENABLED=0 to disable all SMS sending regardless of provider.
# SMS_ENABLED=1
# SMS_API_URL=https://sms-gateway.example/api/send
# SMS_API_KEY=
# Max send attempts before a message is marked failed.
# SMS_MAX_ATTEMPTS=3

# Rate limiting for public (unauthenticated) endpoints (optional overrides)
# RATE_LIMIT_PUBLIC_APPLY_MAX=20
# RATE_LIMIT_ACTIVATION_MAX=30
