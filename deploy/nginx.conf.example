# Smart Rentals — nginx reverse proxy (staging/production)
# Place at /etc/nginx/sites-available/smart-rentals and symlink into sites-enabled.
# Replace staging.smartrentals.co.ke with your real hostname.
# certbot --nginx fills in the ssl_certificate lines below.

upstream smart_rentals_app {
    server 127.0.0.1:4000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name staging.smartrentals.co.ke;

    # certbot will insert the HTTP->HTTPS redirect here on --redirect.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name staging.smartrentals.co.ke;

    # Managed by certbot:
    # ssl_certificate     /etc/letsencrypt/live/staging.smartrentals.co.ke/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/staging.smartrentals.co.ke/privkey.pem;
    # include             /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Uploads are capped at 6 MB by the app; leave headroom.
    client_max_body_size 10m;

    # Security headers (the app also sets nosniff/CSP on /uploads).
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        proxy_pass http://smart_rentals_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# ---------------------------------------------------------------------------
# Caddy alternative (automatic HTTPS). Put this in /etc/caddy/Caddyfile instead
# of using nginx + certbot:
#
#   staging.smartrentals.co.ke {
#       encode gzip
#       reverse_proxy 127.0.0.1:4000
#   }
# ---------------------------------------------------------------------------
