# Production environment template.
# Copy to `.env` on the server (which is git-ignored) and fill in real values.
# The app REFUSES TO START in production if the required settings are unsafe.
#
# Validate before booting:
#   node -e "process.loadEnvFile('.env');const{validateEnvConfig}=await import('./server/src/utils/configGuard.js');const r=validateEnvConfig('production',{jwtSecret:process.env.JWT_SECRET});console.log(r)"
# (or just start the server: the config guard runs on load.)

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# Comma-separated allowlist of browser origins permitted to make CORS requests.
# Use the public HTTPS origin(s) only.
CLIENT_ORIGIN=https://app.your-domain.example

# Public base URL used to build tenant activation links. MUST be HTTPS.
# Defaults to the first CLIENT_ORIGIN value.
PUBLIC_BASE_URL=https://app.your-domain.example

# ---------------------------------------------------------------------------
# Auth (REQUIRED)
# ---------------------------------------------------------------------------
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string

# Secure, HTTPS-only cookies are REQUIRED. The app refuses to start unless this is 1.
COOKIE_SECURE=1

# ---------------------------------------------------------------------------
# Data (optional; defaults shown)
# ---------------------------------------------------------------------------
# DB_PATH=/var/lib/smart-rentals/data.db
# UPLOADS_DIR=/var/lib/smart-rentals/uploads
# BACKUP_DIR=/var/lib/smart-rentals/backups

# Seed admin password, used only on first seed. If blank, a random password is
# generated and printed once. Set explicitly to control it.
# SEED_ADMIN_PASSWORD=

# Tenant activation link lifetime, in hours.
# ACTIVATION_TTL_HOURS=48

# ---------------------------------------------------------------------------
# Rate limiting (optional overrides; sensible production defaults apply)
# ---------------------------------------------------------------------------
# RATE_LIMIT_LOGIN_MAX=20
# RATE_LIMIT_REGISTER_MAX=10
# RATE_LIMIT_INITIATE_MAX=8
# RATE_LIMIT_UPLOAD_MAX=60
# RATE_LIMIT_CALLBACK_MAX=600
# RATE_LIMIT_PUBLIC_APPLY_MAX=20
# RATE_LIMIT_ACTIVATION_MAX=30

# ---------------------------------------------------------------------------
# M-Pesa (Daraja STK Push) — REQUIRED for card-free mobile payments
# ---------------------------------------------------------------------------
# In production mock mode is disabled: MPESA_ENV must be "production" and the
# callback URL a public HTTPS endpoint. Without live credentials, STK push is
# disabled and only manual payments work.
#
# Callback security: Daraja does NOT sign STK Push callbacks, so the callback
# endpoint never completes a payment from the body alone. It correlates the
# callback to a server-created pending payment and confirms status via the
# Daraja STK Push Query API using these credentials (fail closed). Keep the
# callback URL unguessable.
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.your-domain.example/api/payments/mpesa/callback
# Allowed absolute difference (KES) between callback and expected amount. Default 1.
# MPESA_CALLBACK_AMOUNT_TOLERANCE=1

# ---------------------------------------------------------------------------
# SMS notifications
# ---------------------------------------------------------------------------
# Provider:
#   http     - generic REST gateway (requires SMS_API_URL + SMS_API_KEY, and SMS_WEBHOOK_SECRET)
#   mock     - logs only, sends nothing (do NOT use in production)
#   disabled - turns SMS off entirely
# Start with "disabled" so the app boots; switch to "http" and fill the fields
# below to enable real SMS delivery.
SMS_PROVIDER=disabled
SMS_SENDER_ID=SMARTRENT
SMS_ENABLED=1
SMS_API_URL=https://sms-gateway.example/api/send
SMS_API_KEY=
# SMS_MAX_ATTEMPTS=3

# Delivery-status webhook (POST /api/sms/webhook). REQUIRED when SMS_PROVIDER=http,
# otherwise every callback is rejected (fail closed). Your gateway must sign the
# raw body with HMAC-SHA256 using this shared secret:
#   X-SMS-Signature: sha256=<hex HMAC>
# If your gateway also sends X-SMS-Timestamp, the signature must be computed over
# "<timestamp>.<raw body>" and the timestamp must be within the tolerance below.
SMS_WEBHOOK_SECRET=
SMS_WEBHOOK_TOLERANCE_SECONDS=300
